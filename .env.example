# Copy to `.env` and fill in. Used by docker-compose (env_file).

# --- Planning Center Personal Access Token (required) ---
PCO_APP_ID=your_pat_application_id
PCO_SECRET=your_pat_secret

# --- optional ---
# Pin the API version (defaults to the spec this build targets).
PCO_API_VERSION=2026-06-04
# Identify yourself to PCO (required header; put a real contact).
PCO_USER_AGENT=pcomirror/0.1 (+admin@yourchurch.org)

# Public HTTPS URL of THIS service, used when registering webhooks. PCO must be
# able to reach it (put a reverse proxy / tunnel in front that terminates TLS and
# forwards to the container's :8080). Example:
PCOMIRROR_PUBLIC_URL=https://pcomirror.yourchurch.org

# Auto-run an initial backfill on first `serve` startup (1 = yes). At ~300 people
# this is a few requests; leave unset to backfill manually instead.
PCOMIRROR_BACKFILL_ON_START=0

# Webhook subscriptions, re-applied on every `serve` start so a container needs no
# follow-up command. Comma-separated:
#   <subscription_id>:<event>:<url_token>:<authenticity_secret>
# You choose <url_token>, so the receiver URL — PCOMIRROR_PUBLIC_URL + /pco/webhooks/<token>
# — is known before first boot: register it at PCO, then paste PCO's secret here.
# Idempotent (keyed on subscription id); leave the token field empty to keep an
# existing token or mint a random one. Use the JSON form if a secret contains a ','
#   [{"id":"sub_123","event":"...","token":"person-updated-01","secret":"whsec_aaa"}]
# PCOMIRROR_SUBSCRIPTIONS=sub_123:people.v2.events.person.updated:person-updated-01:whsec_aaa

# Serve /people/v2 with NO API key (1 = yes). Only for a trusted LAN — anyone who
# can reach the port gets every mirrored person, and can write through to PCO with
# your PAT. Leave unset and mint keys instead:
#   pcomirror create-api-key --name <app> --scopes 'read:*'
# PCOMIRROR_ALLOW_ANONYMOUS=0

# How many diagnostic events to keep (every mutation, and every upstream failure
# including ones a retry recovered from). Read them at /admin/diagnostics.
# 0 switches recording off.
# PCOMIRROR_DIAGNOSTIC_KEEP=1000

# Divergence checking: how many read *shapes* per scheduler pass to re-ask PCO
# about, comparing its answer with the mirror's. 0 (default) is off; it spends
# real PCO budget. Read the results at /admin/divergence.
# PCOMIRROR_SHADOW_PER_MINUTE=0
# PCOMIRROR_SHADOW_KEEP=200

# Run the service as this uid/gid (default 10001:10001). Set these to the host
# user that owns a bind-mounted /data — otherwise SQLite reports "unable to open
# database file". On a Synology, `id <your-user>` over SSH gives the numbers.
# Ignored when the container is started with --user.
# PUID=1026
# PGID=100

# TLS: path (inside the container) to a CA bundle if PCO egress goes via a proxy.
# PCO_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# The DB path and bind host/port already have container-friendly defaults
# (/data/pcomirror.db, 0.0.0.0:8080) — override only if you need to.
# PCOMIRROR_DB=/data/pcomirror.db
# PCOMIRROR_PORT=8080
